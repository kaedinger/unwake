# Unwake settings: every one and its default. Unwake, its settings page and rc.unwake read
# this file first, then /boot/config/plugins/unwake/unwake.cfg (what the page saved) over it.

# Put Unwake on top of /mnt/user when the array starts (enabled/disabled)
SERVICE="disabled"

# Read the directory trees of disks while they spin anyway (yes/no)
HARVEST="yes"

# File data: "direct" reads a file that lives on exactly one known disk from that
# disk (skips shfs, one page cache layer less); "shfs" reads everything through shfs
DATA_PATH="direct"

# Shares that live on an SSD pool only (shareUseCache only/prefer) are passed through
# to shfs, never cached: they can't wake a disk. These two lists override that:
# EXCLUDED_SHARES are never cached, INCLUDED_SHARES are cached even if pool-only.
EXCLUDED_SHARES=""
INCLUDED_SHARES=""

# After the kernel lets go of many names (the backup's, hours later), hand the freed
# RAM back to the system instead of keeping it for the next night (yes/no)
RETURN_RAM="yes"

LOG_LEVEL="info"
LOG_MAX_SIZE_MB="16"
LOG_TRIM_SIZE_MB="2"

# Not on the settings page. The verifier compares the folders in RAM with the disks and
# repairs what differs (VERIFY="no" turns it off; betas verify regardless): up to
# VERIFY_RATE folders per second and disk, a disk's next pass VERIFY_INTERVAL seconds
# after its last one ended. The settings page shows it on the beta channel only.
VERIFY="yes"
VERIFY_RATE="50"
VERIFY_INTERVAL="86400"
