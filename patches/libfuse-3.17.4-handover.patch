+/*
+ * Unwake: hand a running session over to another process (in-place upgrade).
+ * export copies what INIT negotiated; import gives a fresh, unmounted session
+ * that state and the /dev/fuse fd of the running connection, so it serves
+ * requests right away without waiting for an INIT that never comes again.
+ */
+struct fuse_session_handover {
+	uint32_t magic;		/* FUSE_HANDOVER_MAGIC */
+	uint32_t size;		/* sizeof(struct fuse_session_handover) */
+	struct fuse_conn_info conn;
+	uint64_t bufsize;
+};
+#define FUSE_HANDOVER_MAGIC 0x55574f48	/* "HOWU" */
+int fuse_session_handover_export(struct fuse_session *se,
+				 struct fuse_session_handover *h);
+int fuse_session_handover_import(struct fuse_session *se, int fd,
+				 const struct fuse_session_handover *h);
