+int fuse_session_handover_export(struct fuse_session *se,
+				 struct fuse_session_handover *h)
+{
+	if (!se->got_init)
+		return -EINVAL;
+	memset(h, 0, sizeof(*h));
+	h->magic = FUSE_HANDOVER_MAGIC;
+	h->size = sizeof(*h);
+	h->conn = se->conn;
+	h->bufsize = se->bufsize;
+	return 0;
+}
+
+int fuse_session_handover_import(struct fuse_session *se, int fd,
+				 const struct fuse_session_handover *h)
+{
+	if (h->magic != FUSE_HANDOVER_MAGIC || h->size != sizeof(*h) ||
+	    se->fd != -1 || se->got_init || fd < 0)
+		return -EINVAL;
+	se->fd = fd;
+	se->conn = h->conn;
+	se->bufsize = h->bufsize;
+	se->got_init = 1;
+	return 0;
+}
